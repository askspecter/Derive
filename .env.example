# Reown project ID from https://dashboard.reown.com (required for WalletConnect / QR code wallets)
VITE_REOWN_PROJECT_ID=

# Admin wallet that deploys and owns the contracts. Use a FRESH wallet (no transactions yet):
# its first three transactions deploy the vault, perps and options, so the site derives
# their addresses from this address alone.
VITE_LARRY_ADMIN=

# Optional: only if the contracts were deployed some other way.
# VITE_LARRY_POOL=
# VITE_LARRY_PERPS=
# VITE_LARRY_OPTIONS=

# After moving options to a new contract (0DTE upgrade): the earlier options contract(s), comma separated,
# so options bought there stay visible and claimable.
# VITE_LARRY_OPTIONS_LEGACY=

# Agent Arena registry (LarryArena), deployed from the admin page. Leave empty to show "opens soon".
# VITE_LARRY_ARENA=
# LLP credit market on Morpho: the LarryVaultOracle address from the admin page (Credit section).
# VITE_LLP_ORACLE=

# Optional: custom RPC (for example a private Alchemy URL, or http://127.0.0.1:8545 for local tests)
# VITE_RPC_URL=

# Hyperliquid perps (powered by Hyperliquid). Builder address that earns the Larry builder fee (defaults to
# VITE_LARRY_ADMIN; it needs at least 100 USDC in its Hyperliquid perps account), the fee in tenths of a basis
# point (50 = 0.05%, max 100), and VITE_HL_TESTNET=1 to use Hyperliquid testnet.
# VITE_HL_BUILDER=
# VITE_HL_BUILDER_FEE=50
# VITE_HL_TESTNET=

# $LARRY launch supply in whole tokens, only if $LARRY was ever burned with burn() instead of a transfer to
# the dead address. The burn tracker then counts the supply reduction too.
# VITE_LARRY_INITIAL_SUPPLY=

# LarryBuyback contract (deployed from the admin page), shown with live stats on the burn page.
# VITE_LARRY_BUYBACK=
