{
  "name": "larry-agent-kit",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server and TypeScript SDK that let AI agents trade on Larry (Robinhood Chain)",
  "type": "module",
  "bin": {
    "larry-mcp": "dist/larry-mcp.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:setup": "node test/setup.mjs test/.env.json",
    "test": "LARRY_TEST_ENV=test/.env.json node --test --test-concurrency=1 --test-force-exit test/mcp.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.0"
  }
}
