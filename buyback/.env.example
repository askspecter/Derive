# Copy to buyback/.env and fill in. Never commit the real file.

# Keeper wallet: signs the buy triggers and pays gas. With a buyback contract it holds only a little ETH for gas.
BUYBACK_PRIVATE_KEY=

# Recommended: the LarryBuyback contract from the admin page. It holds the ETH, enforces the limits onchain
# and burns every $LARRY it buys.
BUYBACK_CONTRACT=
# $LARRY trades in a Uniswap V4 ETH pool: the contract swaps on it directly (set the pool on the admin page).
BUYBACK_ROUTE=v4

# Or let 0x find the route (free API key at dashboard.0x.org):
# BUYBACK_ROUTE=0x
# BUYBACK_0X_API_KEY=

# Or route through a DEX router directly (v2 or v3), with or without a contract:
# BUYBACK_ROUTE=v2
# BUYBACK_ROUTER=
# BUYBACK_QUOTER=        (v3 only)
# BUYBACK_V3_FEE=3000    (v3 only)
# Without a contract the keeper wallet spends its own ETH or a token (BUYBACK_PAY=eth or a token address).
# BUYBACK_PAY=eth

# About 0.00001 ETH per buy (randomly ±30%) every 10 seconds
BUYBACK_EVERY_SECONDS=10
BUYBACK_AMOUNT=0.00001
BUYBACK_JITTER=0.3
# Daily cap for the no-contract mode (a contract uses its own onchain cap)
BUYBACK_MAX_PER_DAY=0.01
BUYBACK_SLIPPAGE_BPS=300
BUYBACK_MIN_GAS_ETH=0.0005

# 1 to simulate every buy and send nothing
BUYBACK_DRY_RUN=0
