# Copy to buyback/.env and fill in. Never commit the real file.

# Wallet that pays for the buybacks. Use a fresh wallet holding only the buyback budget and some ETH for gas.
BUYBACK_PRIVATE_KEY=

# DEX where $LARRY trades. Run `node buyback/larry-buyback.mjs detect <txhash of a $LARRY buy>` to find it.
BUYBACK_DEX=v2
BUYBACK_ROUTER=
# Uniswap V3 style DEX only:
# BUYBACK_QUOTER=
# BUYBACK_V3_FEE=3000

# What the bot spends: eth, or a token address (USDG: 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168)
BUYBACK_PAY=eth
# Optional middle token when there is no direct pool, e.g. WETH
# BUYBACK_VIA=

# Every 10 seconds, about 0.00001 ETH per buy (randomly ±30%), at most 0.01 ETH a day
BUYBACK_EVERY_SECONDS=10
BUYBACK_AMOUNT=0.00001
BUYBACK_JITTER=0.3
BUYBACK_MAX_PER_DAY=0.01
BUYBACK_SLIPPAGE_BPS=300
BUYBACK_MIN_GAS_ETH=0.0005

# 1 to simulate every buy and send nothing
BUYBACK_DRY_RUN=0
